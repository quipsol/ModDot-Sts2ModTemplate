<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Quipsol.MoDot.Sts2.Templates</PackageId>
    <PackageVersion>0.1.0</PackageVersion>
    <Title>MoDot Sts2 Mod Templates</Title>
    <Authors>Quipsol</Authors>
    <Description>Templates to use when creating a Slay the Spire 2 mod while using the MoDot fork</Description>
    <PackageTags>dotnet-new;templates;</PackageTags>
    <PackageProjectUrl>https://github.com/quipsol/ModDot-Sts2ModTemplate/</PackageProjectUrl>
    <PackageReleaseNotes>First release: Empty, Content and Character mod templates for MoDot 4.5.1-m1. See https://github.com/quipsol/ModDot-Sts2ModTemplate/releases</PackageReleaseNotes>
    
    <PackageType>Template</PackageType>
    <TargetFramework>net9.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <LocalizeTemplates>false</LocalizeTemplates>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RootNamespace>Quipsol.MoDot.Sts2.Templates</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.TemplateEngine.Tasks" Version="*" PrivateAssets="all" IsImplicitlyDefined="true"/>
  </ItemGroup>

  <ItemGroup>
    <!-- NuGet appends each file's path below content\ to PackagePath, so the templates land in content/<Template>/
         (without it, content/content/<Template>/). -->
    <Content Include="content\**\*" Exclude="content\**\bin\**;content\**\obj\**;content\**\packages\**;content\**\.idea\**;content\**\.git\**" PackagePath="content\" />
    <Compile Remove="**\*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="bin\**" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="content\ContentModTemplate\ContentModCode\Core\Models\Cards\" />
    <Folder Include="content\ContentModTemplate\ContentModCode\Core\Models\Powers\" />
    <Folder Include="content\ContentModTemplate\ContentModCode\Core\Models\Relics\" />
  </ItemGroup>

</Project>
