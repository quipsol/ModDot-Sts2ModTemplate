<Project>
    <PropertyGroup>
        <!-- Path to your MoDot executable, used to pack the mod when publishing -->
        <ModotPath>C:/MoDot/MoDot_v4.5.1-stable_mono_win64.exe</ModotPath>
        <!-- Examples for Windows, Linux, Mac (Linux and Mac builds have to be compiled yourself) -->
        <!-- C:/MoDot/MoDot_v4.5.1-stable_mono_win64.exe -->
        <!-- /opt/modot/godot.linuxbsd.editor.x86_64.mono -->
        <!-- /Users/user/Applications/MoDot.app/Contents/MacOS/Godot -->

        <!-- The mods folder of that MoDot installation; Debug builds are copied to <ModotModsPath><ProjectName>Mods/<ProjectName>/ -->
        <ModotModsPath>C:/MoDot/mods/</ModotModsPath>
        
        <!-- If sts2 is not found automatically, uncomment the following and set it manually -->
        <!-- <Sts2Path>?/steamapps/common/Slay the Spire 2</Sts2Path> -->
    </PropertyGroup>
</Project>