<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Quipsol.ModDot.Sts2.Templates</PackageId>
    <PackageVersion>0.1.0</PackageVersion>
    <Title>ModDot Sts2 Mod Templates</Title>
    <Authors>Quipsol</Authors>
    <Description>Templates to use when creating a Slay the Spire 2 mod</Description>
    <PackageTags>dotnet-new;templates;</PackageTags>
    <PackageProjectUrl>https://github.com/quipsol/ModDot-Sts2ModTemplate/</PackageProjectUrl>
    <PackageReleaseNotes>none</PackageReleaseNotes>
    
    <PackageType>Template</PackageType>
    <TargetFramework>net9.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <LocalizeTemplates>false</LocalizeTemplates>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RootNamespace>Quipsol.ModDot.Sts2.Templates</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.TemplateEngine.Tasks" Version="*" PrivateAssets="all" IsImplicitlyDefined="true"/>
  </ItemGroup>

  <ItemGroup>
    <Content Include="content\**\*" Exclude="content\**\bin\**;content\**\obj\**;content\**\packages\**;content\**\.idea\**;content\**\.git\**" />
    <Compile Remove="**\*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="bin\**" />
  </ItemGroup>

</Project>
